<Window x:Class="ScreenTimeTracker.App.FocusDurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Focus Duration"
        Width="280" Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="#1E1E1E" 
            CornerRadius="15" 
            BorderBrush="#333" 
            BorderThickness="1"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" 
                       Text="Focus Duration" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Preset Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button x:Name="Btn25" Content="25m" Width="55" Height="35" Margin="5,0" 
                        Background="#333" Foreground="White" BorderThickness="0"
                        Click="Preset_Click" Tag="25"/>
                <Button x:Name="Btn45" Content="45m" Width="55" Height="35" Margin="5,0"
                        Background="#333" Foreground="White" BorderThickness="0"
                        Click="Preset_Click" Tag="45"/>
                <Button x:Name="Btn60" Content="60m" Width="55" Height="35" Margin="5,0"
                        Background="#333" Foreground="White" BorderThickness="0"
                        Click="Preset_Click" Tag="60"/>
            </StackPanel>

            <!-- Custom Input -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBox x:Name="TxtCustomMinutes" 
                         Width="60" Height="30" 
                         Text="25"
                         FontSize="16"
                         TextAlignment="Center"
                         Background="#252525"
                         Foreground="White"
                         BorderBrush="#444"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="minutes" 
                           Foreground="#888" 
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Start Button -->
            <Button Grid.Row="3" 
                    x:Name="BtnStart"
                    Content="Start Focus"
                    Height="38"
                    Background="#00E096"
                    Foreground="Black"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Start_Click"/>
        </Grid>
    </Border>
</Window>
