<Window x:Class="ScreenTimeTracker.App.BlockedAppOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stay Focused"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        ResizeMode="NoResize">
    
    <Grid>
        <!-- Semi-transparent light backdrop with purple tint -->
        <Rectangle Fill="#E6F8F6FA" MouseLeftButtonDown="Backdrop_Click"/>
        
        <!-- Centered content card -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="20"
                Padding="48,36"
                MinWidth="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.15" Color="#9333EA"/>
            </Border.Effect>
            
            <StackPanel HorizontalAlignment="Center">
                <!-- Icon -->
                <Border Width="72" Height="72" Background="#FEE2E2" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="🚫" 
                               FontSize="36" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                
                <!-- Title -->
                <TextBlock Text="Stay Focused!" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                
                <!-- Blocked app name -->
                <TextBlock x:Name="TxtAppName" 
                           Text="Discord is blocked during focus" 
                           FontSize="15" 
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                
                <!-- Motivation message -->
                <Border Background="#ECFDF5" CornerRadius="10" Padding="16,10" Margin="0,0,0,24">
                    <TextBlock Text="✨ You're doing great! Keep your momentum." 
                               FontSize="14" 
                               Foreground="#059669"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>
                
                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Return to Work (Primary) -->
                    <Button x:Name="BtnReturnToWork"
                            Click="ReturnToWork_Click"
                            Background="#9333EA"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="24,14"
                            Margin="0,0,12,0"
                            Cursor="Hand"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" 
                                        CornerRadius="12" 
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎯" Margin="0,0,8,0"/>
                                        <TextBlock Text="Return to Work"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Allow This Time (Secondary) -->
                    <Button x:Name="BtnAllowOnce"
                            Content="Allow This Time"
                            Click="AllowOnce_Click"
                            Background="Transparent"
                            Foreground="#6B7280"
                            FontSize="14"
                            Padding="24,14"
                            Cursor="Hand"
                            BorderThickness="1"
                            BorderBrush="#E5E7EB">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                                        <Setter Property="Foreground" Value="#1F2937"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                
                <!-- Countdown hint -->
                <TextBlock x:Name="TxtCountdown"
                           Text="Auto-closing in 5s..." 
                           FontSize="12" 
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
