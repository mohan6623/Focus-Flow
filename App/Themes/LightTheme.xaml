<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tempo Theme Colors (Light) -->
    <Color x:Key="BgColor">#F8F6FA</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="SidebarBgColor">#FFFFFF</Color>
    
    <Color x:Key="PrimaryTextColor">#1F2937</Color> <!-- Gray-800 -->
    <Color x:Key="SecondaryTextColor">#6B7280</Color> <!-- Gray-500 -->
    <Color x:Key="AccentColor">#9333EA</Color> <!-- Purple-600 -->
    <Color x:Key="AccentLightColor">#E9D5FF</Color> <!-- Purple-200 -->
    
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color> <!-- Gray-200 -->

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    
    <!-- Graph Colors -->
    <Color x:Key="BarActiveColorStart">#9333EA</Color>
    <Color x:Key="BarActiveColorEnd">#7E22CE</Color>
    <Color x:Key="BarInactiveColorStart">#E9D5FF</Color>
    <Color x:Key="BarInactiveColorEnd">#D8B4FE</Color>

    <!-- Category Colors (Attractive & Distinguishable for Light Theme) -->
    <Color x:Key="CategoryProductivityColor">#10B981</Color>    <!-- Emerald-500 -->
    <Color x:Key="CategoryEntertainmentColor">#8B5CF6</Color>   <!-- Violet-500 -->
    <Color x:Key="CategoryCommunicationColor">#3B82F6</Color>   <!-- Blue-500 -->
    <Color x:Key="CategoryGamingColor">#F43F5E</Color>          <!-- Rose-500 -->
    <Color x:Key="CategoryBrowsingColor">#0EA5E9</Color>        <!-- Sky-500 -->
    <Color x:Key="CategorySocialColor">#EC4899</Color>          <!-- Pink-500 -->
    <Color x:Key="CategoryShoppingColor">#F59E0B</Color>        <!-- Amber-500 -->
    <Color x:Key="CategorySystemColor">#64748B</Color>          <!-- Slate-500 -->
    <Color x:Key="CategoryOtherColor">#71717A</Color>           <!-- Zinc-500 -->

    <SolidColorBrush x:Key="CategoryProductivityBrush" Color="{StaticResource CategoryProductivityColor}"/>
    <SolidColorBrush x:Key="CategoryEntertainmentBrush" Color="{StaticResource CategoryEntertainmentColor}"/>
    <SolidColorBrush x:Key="CategoryCommunicationBrush" Color="{StaticResource CategoryCommunicationColor}"/>
    <SolidColorBrush x:Key="CategoryGamingBrush" Color="{StaticResource CategoryGamingColor}"/>
    <SolidColorBrush x:Key="CategoryBrowsingBrush" Color="{StaticResource CategoryBrowsingColor}"/>
    <SolidColorBrush x:Key="CategorySocialBrush" Color="{StaticResource CategorySocialColor}"/>
    <SolidColorBrush x:Key="CategoryShoppingBrush" Color="{StaticResource CategoryShoppingColor}"/>
    <SolidColorBrush x:Key="CategorySystemBrush" Color="{StaticResource CategorySystemColor}"/>
    <SolidColorBrush x:Key="CategoryOtherBrush" Color="{StaticResource CategoryOtherColor}"/>
    
</ResourceDictionary>
