<Window x:Class="ScreenTimeTracker.App.GoalEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Focus Goal"
        Height="320" Width="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource BgBrush}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Radio Buttons -->
                <RowDefinition Height="Auto"/> <!-- Slider -->
                <RowDefinition Height="*"/>    <!-- Spacer -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Edit Focus Goal" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtDateContext" Text="Tuesday, Feb 4" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Scope Selection -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <TextBlock Text="Apply to:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <RadioButton x:Name="RbTodayOnly" Content="This day only" Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="True" Margin="0,0,0,6"/>
                <RadioButton x:Name="RbWeekdays" Content="All weekdays (Mon-Fri)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <RadioButton x:Name="RbWeekends" Content="All weekends (Sat-Sun)" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Goal Slider -->
            <StackPanel Grid.Row="2">
                <Grid>
                    <TextBlock Text="Daily Goal:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtGoalValue" Text="2h 00m" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="SliderGoal" 
                        Minimum="15" Maximum="480" Value="120" 
                        TickFrequency="15" IsSnapToTickEnabled="True"
                        ValueChanged="SliderGoal_ValueChanged"
                        Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelButton_Click" Padding="16,8" Margin="0,0,10,0"
                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Save" Click="SaveButton_Click" Padding="16,8"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
