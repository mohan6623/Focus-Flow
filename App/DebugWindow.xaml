<Window x:Class="ScreenTimeTracker.App.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tracker Debug Console" Height="500" Width="850"
        Background="#F8F6FA" Foreground="#1F2937"
        WindowStyle="None" AllowsTransparency="True">
    
    <Border Background="#FFFFFF" CornerRadius="16" BorderBrush="#E5E7EB" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
        </Border.Effect>
        
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Debug Console" FontSize="20" FontWeight="Bold" Foreground="#9333EA"/>
                    <TextBlock Text="Watch this window while switching apps to verify detection." Foreground="#6B7280" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        Width="30" Height="30" Click="CloseButton_Click" Cursor="Hand"/>
            </Grid>

            <Border Grid.Row="1" Background="#F9FAFB" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
                <TextBox x:Name="TxtLog"
                         Background="Transparent" Foreground="#374151" 
                         FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" BorderThickness="0"/>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Check Current" Click="CheckCurrent_Click" Padding="16,10" Margin="0,0,10,0" 
                        Background="#F3F4F6" Foreground="#1F2937" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E9D5FF"/>
                                    <Setter Property="Foreground" Value="#9333EA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Clear" Click="Clear_Click" Padding="16,10" 
                        Background="#F3F4F6" Foreground="#1F2937" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E9D5FF"/>
                                    <Setter Property="Foreground" Value="#9333EA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
