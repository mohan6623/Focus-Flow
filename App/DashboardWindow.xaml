<Window x:Class="ScreenTimeTracker.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FocusFlow Dashboard" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Tempo Theme Colors -->
        <Color x:Key="BgColor">#F8F6FA</Color>
        <Color x:Key="CardColor">#FFFFFF</Color>
        <Color x:Key="AccentColor">#9333EA</Color>
        <Color x:Key="AccentLightColor">#E9D5FF</Color>
        <Color x:Key="SecondaryTextColor">#6B7280</Color>
        <Color x:Key="PrimaryTextColor">#1F2937</Color>
        <Color x:Key="SuccessColor">#22C55E</Color>
        <Color x:Key="WarningColor">#F59E0B</Color>
        <Color x:Key="DangerColor">#EF4444</Color>
        <Color x:Key="SidebarBgColor">#FFFFFF</Color>
        
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource PrimaryTextColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource SecondaryTextColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Button Style -->
        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Main Container with Rounded Corners for the Window itself -->
    <Border Background="{StaticResource BgBrush}" CornerRadius="16" BorderThickness="1" BorderBrush="#E5E7EB">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" CornerRadius="16,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Logo -->
                        <RowDefinition Height="Auto"/> <!-- Navigation -->
                        <RowDefinition Height="*"/>    <!-- Spacer -->
                        <RowDefinition Height="Auto"/> <!-- Streak Widget -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
                    </Grid.RowDefinitions>

                    <!-- Logo/Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,24,20,30">
                        <Ellipse Width="36" Height="36" Fill="{StaticResource AccentBrush}"/>
                        <TextBlock Text="FocusFlow" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1">
                        <Button Style="{StaticResource NavButtonActiveStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Dashboard" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Activity Log" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Focus Mode" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔥" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Streaks" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Insights" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Streak Widget (Moved to Main Content) -->

                    <!-- Bottom Actions -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,20">
                        <Button Style="{StaticResource NavButtonStyle}" Click="DebugButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Settings" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Main Content -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI Variable Display"/>
                        <TextBlock Text="Overview of your digital habits" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                         <!-- Focus Button (Star Feature) -->
                         <Button x:Name="BtnFocus" 
                                 Style="{StaticResource PrimaryButtonStyle}"
                                 Click="FocusButton_Click"
                                 Margin="0,0,15,0">
                             <StackPanel Orientation="Horizontal">
                                 <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>
                                 <TextBlock Text="Start Focus" FontSize="13"/>
                             </StackPanel>
                         </Button>
                         <Button x:Name="BtnMinimize" 
                            Content="—" 
                            Foreground="{StaticResource TextSecondaryBrush}" 
                            Background="Transparent"
                            BorderThickness="0"
                            Width="30" Height="30"
                            Click="MinimizeButton_Click"
                            Cursor="Hand"/>
                    
                    <Button x:Name="BtnDebug" 
                            Content="🐞" 
                            Foreground="{StaticResource TextSecondaryBrush}" 
                            Background="Transparent"
                            BorderThickness="0"
                            Width="30" Height="30"
                            Click="DebugButton_Click"
                            ToolTip="Open Debug Console"
                            Cursor="Hand"/>

                    <Button x:Name="BtnClose" 
                            Content="✕" 
                            Foreground="{StaticResource TextSecondaryBrush}" 
                            Background="Transparent"
                            BorderThickness="0"
                            Width="30" Height="30"
                            Click="CloseButton_Click"
                            Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Main Dashboard Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.5*"/> <!-- General Statistics -->
                        <ColumnDefinition Width="4*"/>   <!-- Daily Report -->
                        <ColumnDefinition Width="2.5*"/> <!-- Quick Stats -->
                    </Grid.ColumnDefinitions>

                    <!-- COL 1: General Statistics -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="General Statistics" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Border Background="{StaticResource AccentLightBrush}" CornerRadius="12" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="+8% Improve" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Content: List + Stacked Bar -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/> <!-- List -->
                                    <ColumnDefinition Width="1*"/> <!-- Chart -->
                                </Grid.ColumnDefinitions>

                                <!-- App List -->
                                <StackPanel x:Name="AppListPanel" VerticalAlignment="Center"/>

                            <!-- Stacked Bar Visual -->
                                <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="12" Margin="10,0,0,0" Padding="5">
                                    <Grid x:Name="StackedBarContainer">
                                        <Grid.RowDefinitions>
                                            <!-- Dynamic rows will be added here in code-behind -->
                                        </Grid.RowDefinitions>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- COL 2: Daily Report -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- Header -->
                                <RowDefinition Height="1.2*"/>   <!-- Weekly Chart -->
                                <RowDefinition Height="1*"/>     <!-- Hourly Chart -->
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Activity Report" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtReportSubtitle" Text="Last 7 Days" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border x:Name="ViewModeBadge" Background="{StaticResource AccentLightBrush}" CornerRadius="12" HorizontalAlignment="Right" Padding="12,6">
                                    <TextBlock Text="Weekly View" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Weekly Chart (always visible) -->
                            <Grid Grid.Row="1" Margin="0,10">
                                <Grid x:Name="WeeklyGraphContainer">
                                    <!-- 7 columns for 7 days will be added in code-behind -->
                                </Grid>
                            </Grid>

                            <!-- Hourly Chart (appears when day is clicked) -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid x:Name="HourlyGraphContainer" Visibility="Collapsed">
                                    <!-- 24 columns for 24 hours will be added in code-behind -->
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- COL 3: Quick Stats -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Streak Widget (Moved here) -->
                        <Border Grid.Row="0" Background="White" CornerRadius="16" Margin="0,0,0,16" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.08" Color="#000000"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Flame Icon -->
                                <TextBlock Text="🔥" FontSize="48" VerticalAlignment="Top" Margin="-4,-8,12,0" Foreground="#DC2626"/> 
                                
                                <StackPanel Grid.Column="1">
                                    <!-- Title -->
                                    <TextBlock TextWrapping="Wrap" LineHeight="20">
                                        <Run x:Name="TxtStreakCount" Text="0" FontWeight="Bold" FontSize="15" Foreground="#1F2937"/>
                                        <Run Text=" days streak." FontWeight="Bold" FontSize="15" Foreground="#1F2937"/>
                                        <LineBreak/>
                                        <Run x:Name="TxtStreakMessage" Text="Keep it up!" FontSize="13" Foreground="#4B5563"/>
                                    </TextBlock>

                                    <!-- Days Row -->
                                    <Border Background="#F3F4F6" CornerRadius="8" Padding="8,8" Margin="0,12,0,0">
                                         <Grid x:Name="StreakDaysGrid">
                                             <!-- Populated in Code Behind -->
                                         </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Active Time (Moved Down) -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8" VerticalAlignment="Top">
                            <StackPanel VerticalAlignment="Center">
                                 <TextBlock Text="Total Active Time" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                 <TextBlock x:Name="TxtActiveTime" Text="0h 0m" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                 <Grid Margin="0,15,0,0">
                                     <Border Background="#E5E7EB" CornerRadius="4" Height="8"/>
                                     <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Height="8" HorizontalAlignment="Left" Width="150"/>
                                 </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
