<Window x:Class="ScreenTimeTracker.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FocusFlow Dashboard" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Styles using DynamicResource -->
        
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Button Style -->
        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Custom ScrollBar Style -->
        <Style x:Key="DarkScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Foreground" Value="#374151"/> <!-- Gray-700 Arrow -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/> <!-- Slightly wider for usability -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="GridRoot" Width="12" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition MaxHeight="18"/>
                                <RowDefinition Height="0.00001*"/>
                                <RowDefinition MaxHeight="18"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Track -->
                             <Border Grid.RowSpan="3" CornerRadius="6" Background="Transparent"/> 

                            <!-- Up Button -->
                            <RepeatButton x:Name="DecreaseRepeat" Command="ScrollBar.LineUpCommand" Foreground="#4B5563" Style="{DynamicResource ScrollBarButtonStyle}">
                                <Path Data="M 0 4 L 4 0 L 8 4 Z" Fill="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RepeatButton>

                            <!-- Track Area (Thumb) -->
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="true" Focusable="false">
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="false" Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="false" Background="Transparent"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                            
                            <!-- Down Button -->
                            <RepeatButton x:Name="IncreaseRepeat" Grid.Row="2" Command="ScrollBar.LineDownCommand" Foreground="#4B5563" Style="{DynamicResource ScrollBarButtonStyle}">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar Thumb Style -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border CornerRadius="4" Background="#4B5563" Margin="2" Width="8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar Button Style -->
        <Style x:Key="ScrollBarButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Rounded Corners for the Window itself -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" CornerRadius="16,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Logo -->
                        <RowDefinition Height="Auto"/> <!-- Navigation -->
                        <RowDefinition Height="*"/>    <!-- Spacer -->
                        <RowDefinition Height="Auto"/> <!-- Streak Widget -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
                    </Grid.RowDefinitions>

                    <!-- Logo/Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,24,20,30">
                        <Ellipse Width="36" Height="36" Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="FocusFlow" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1">
                        <Button x:Name="NavDashboard" Style="{StaticResource NavButtonActiveStyle}" Click="NavDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Dashboard" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavActivityLog" Style="{StaticResource NavButtonStyle}" Click="NavActivityLog_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Activity Log" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavFocusMode" Style="{StaticResource NavButtonStyle}" Click="NavFocusMode_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Focus Mode" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavStreaks" Style="{StaticResource NavButtonStyle}" Click="NavStreaks_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔥" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Streaks" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavInsights" Style="{StaticResource NavButtonStyle}" Click="NavInsights_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Insights" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Streak Widget (Moved to Main Content) -->

                    <!-- Bottom Actions -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,20">
                        <Button Style="{StaticResource NavButtonStyle}" Click="DebugButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Settings" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Main Content -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI Variable Display"/>
                        <TextBlock Text="Overview of your digital habits" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TxtTrackingDebug" Text="Tracking: ..." FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" Opacity="0.8"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                         <!-- Theme Toggle -->
                         <Button x:Name="BtnThemeTheme" 
                                 Click="ThemeButton_Click"
                                 Width="36" Height="36"
                                 Margin="0,0,10,0"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}">
                             <TextBlock Text="🌙" FontSize="16"/>
                             <Button.Template>
                                 <ControlTemplate TargetType="Button">
                                     <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                         <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                     </Border>
                                 </ControlTemplate>
                             </Button.Template>
                         </Button>

                         <!-- Focus Button (Star Feature) -->
                         <Button x:Name="BtnFocus" 
                                 Style="{StaticResource PrimaryButtonStyle}"
                                 Click="FocusButton_Click"
                                 Margin="0,0,15,0">
                             <StackPanel Orientation="Horizontal">
                                 <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>
                                 <TextBlock Text="Start Focus" FontSize="13"/>
                             </StackPanel>
                         </Button>
                         <Button x:Name="BtnMinimize" 
                            Content="—" 
                            Foreground="{DynamicResource TextSecondaryBrush}" 
                            Background="Transparent"
                            BorderThickness="0"
                            Width="30" Height="30"
                            Click="MinimizeButton_Click"
                            Cursor="Hand"/>
                    
                    <Button x:Name="BtnDebug" 
                            Content="🐞" 
                            Foreground="{DynamicResource TextSecondaryBrush}" 
                            Background="Transparent"
                            BorderThickness="0"
                            Width="30" Height="30"
                            Click="DebugButton_Click"
                            ToolTip="Open Debug Console"
                            Cursor="Hand"/>

                    <Button x:Name="BtnClose" 
                            Content="✕" 
                            Foreground="{DynamicResource TextSecondaryBrush}" 
                            Background="Transparent"
                            BorderThickness="0"
                            Width="30" Height="30"
                            Click="CloseButton_Click"
                            Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Main Dashboard Grid (Named for Navigation Switching) -->
                <!-- Use 2 Columns -->
                <Grid x:Name="DashboardContent" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5.75*"/>   <!-- Daily Report (Restored slightly) -->
                        <ColumnDefinition Width="3.75*"/>   <!-- Reorganized Stats (Reduced slightly) -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- COL 1: Center Column (Focus Progress + Daily Report) -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Focus Progress -->
                            <RowDefinition Height="*"/>    <!-- Daily Report -->
                        </Grid.RowDefinitions>

                        <!-- 1. Focus Session Progress Card -->
                        <Border Grid.Row="0" x:Name="FocusProgressCard" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Progress Circle -->
                                    <ColumnDefinition Width="*"/>    <!-- Details -->
                                </Grid.ColumnDefinitions>

                                <!-- Circular Progress -->
                                <Grid Width="100" Height="100" Margin="0,0,24,0" Cursor="Hand" MouseLeftButtonDown="FocusTimerDisplay_Click" ToolTip="Click to toggle time left/spent">
                                    <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="8" Fill="Transparent"/>
                                    <Ellipse x:Name="FocusProgressArc" 
                                             Stroke="{DynamicResource AccentBrush}" 
                                             StrokeThickness="8" 
                                             Fill="Transparent"
                                             StrokeDashArray="0 100"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtFocusTimeLeft" Text="25:00" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtFocusTimeLabel" Text="LEFT" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Focus Session Info -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtFocusStatus" Text="Focus Session Active" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="TxtCurrentIntent" Text="Deep Work on Project" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,8" TextTrimming="CharacterEllipsis"/>
                                        
                                        <ProgressBar x:Name="FocusProgressBar" Height="6" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource AccentBrush}" Value="40" BorderThickness="0">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid>
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                    </StackPanel>
                                    
                                    <!-- Stop Button -->
                                    <Button x:Name="BtnStopFocus" Grid.Row="1" 
                                            Click="StopFocusButton_Click"
                                            HorizontalAlignment="Right" 
                                            Margin="0,10,0,0"
                                            Padding="12,6"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{DynamicResource DangerBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⏹" FontSize="12" Foreground="White" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Stop" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 2. Daily Report Card -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>   <!-- Daily Average Header -->
                                    <RowDefinition Height="1.5*"/>   <!-- Weekly Chart -->
                                    <RowDefinition Height="Auto"/>   <!-- Category Legend -->
                                </Grid.RowDefinitions>
    
                                <!-- Daily Average Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Daily Average" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock x:Name="TxtDailyAverage" Text="0h 0m" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border x:Name="TxtDailyChange" Background="{DynamicResource SuccessBrush}" CornerRadius="12" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock x:Name="TxtDailyChangeText" Text="-12%" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
    
                                <!-- Weekly Chart -->
                                <Grid Grid.Row="1" Margin="0,10">
                                    <Grid x:Name="WeeklyGraphContainer">
                                        <!-- 7 columns for 7 days will be added in code-behind -->
                                    </Grid>
                                </Grid>
    
                                <!-- Category Legend -->
                                <Grid Grid.Row="2" Margin="0,15,0,0">
                                    <Grid x:Name="CategoryLegendContainer">
                                        <!-- 2x2 grid of category legends will be added in code-behind -->
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- COL 2: Quick Stats & App Usage -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Streak -->
                            <RowDefinition Height="Auto"/> <!-- Active Time -->
                            <RowDefinition Height="*"/>    <!-- Top Apps -->
                        </Grid.RowDefinitions>

                        <!-- Streak Widget (Integrated Theme & Refined Layout) -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" CornerRadius="20" Margin="0,0,0,16" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Icon/Streak Box Section -->
                                    <ColumnDefinition Width="*"/>    <!-- Progress Section -->
                                </Grid.ColumnDefinitions>

                                <!-- Left: Icon + Streak Count Box -->
                                <Border Grid.Column="0" Background="{DynamicResource BgBrush}" CornerRadius="20" Width="110" Height="125" HorizontalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🔥" FontSize="48" HorizontalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                    <GradientStop Color="#FF2D55" Offset="0.0"/>
                                                    <GradientStop Color="#FF5E3A" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FF2D55" Opacity="0.4"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock TextAlignment="Center" Margin="0,4,0,0">
                                            <Run x:Name="TxtStreakCount" Text="0" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Run Text="days" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="focus streak" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,0" Opacity="0.8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Right: Progress + Days -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Goal Progress Header -->
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="TxtFocusedToday" Text="0m" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtGoalTotal" Text=" / 2h" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,1" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <!-- Edit Pencil Button -->
                                        <Button x:Name="BtnEditGoal" 
                                                Click="EditGoalButton_Click"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Edit daily goal">
                                            <TextBlock Text="✏️" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>

                                    <!-- Progress Bar -->
                                    <Border Background="{DynamicResource BgBrush}" CornerRadius="5" Height="10" Margin="0,0,0,14">
                                        <Border x:Name="StreakProgressFill" CornerRadius="5" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentBrush}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource AccentColor}" Opacity="0.3"/>
                                            </Border.Effect>
                                        </Border>
                                    </Border>

                                    <!-- Weekly Timeline -->
                                    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" Padding="8,6">
                                         <Grid x:Name="StreakDaysGrid">
                                             <!-- Populated in Code Behind -->
                                         </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Active Time -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                 <TextBlock Text="Screen Time" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15"/>
                                 <TextBlock x:Name="TxtActiveTime" Text="0h 0m" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                 <Grid Margin="0,10,0,0">
                                     <Border Background="{DynamicResource BgBrush}" CornerRadius="4" Height="8"/>
                                     <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Height="8" HorizontalAlignment="Left" Width="150"/>
                                 </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Top Apps Widget (New) -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="Most Used Apps" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DarkScrollBarStyle}"/>
                                    </ScrollViewer.Resources>
                                    <StackPanel x:Name="AppUsageListContainer">
                                        <!-- Items filled by C# -->
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 3. Streaks Page Content (Hidden by Default) -->
                <Grid x:Name="StreaksContent" Grid.Row="1" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,20,20">
                            <!-- Header -->
                            <TextBlock Text="Your Streak Journey" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtStreakMotivation" Text="Keep building your focus habit!" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,24"/>

                            <!-- Stats Cards Row -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Current Streak Card -->
                                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                        <TextBlock Text="🔥" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtStreaksPageCurrent" Text="0" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Current Streak" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Longest Streak Card -->
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                        <TextBlock Text="🏆" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtStreaksPageLongest" Text="0" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Longest Streak" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Monthly Focus Card -->
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                        <TextBlock Text="⏱️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtStreaksPageMonthlyFocus" Text="0h" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="This Month" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Calendar Section -->
                            <Border Style="{StaticResource CardStyle}" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Month Navigation -->
                                        <RowDefinition Height="Auto"/> <!-- Day Headers -->
                                        <RowDefinition Height="*"/>    <!-- Calendar Days -->
                                    </Grid.RowDefinitions>

                                    <!-- Month Navigation -->
                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <Button x:Name="BtnCalendarPrev" Content="◀" Click="CalendarPrev_Click" HorizontalAlignment="Left" 
                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" 
                                                FontSize="16" Cursor="Hand" Padding="8,4"/>
                                        <TextBlock x:Name="TxtCalendarMonth" Text="February 2026" FontSize="18" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnCalendarNext" Content="▶" Click="CalendarNext_Click" HorizontalAlignment="Right"
                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" 
                                                FontSize="16" Cursor="Hand" Padding="8,4"/>
                                    </Grid>

                                    <!-- Day Headers -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Sun" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Mon" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Tue" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Wed" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="Thu" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="Fri" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="Sat" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </Grid>

                                    <!-- Calendar Grid (6 rows x 7 cols) -->
                                    <Grid x:Name="CalendarDaysGrid" Grid.Row="2">
                                        <!-- Populated dynamically in code-behind -->
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Milestones Section -->
                            <TextBlock Text="Milestones" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,24,0,12"/>
                            <Grid x:Name="MilestonesGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Populated dynamically -->
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
