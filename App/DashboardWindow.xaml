<Window x:Class="ScreenTimeTracker.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Habicial Dashboard" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Colors -->
        <Color x:Key="BgColor">#121212</Color>
        <Color x:Key="CardColor">#1E1E1E</Color>
        <Color x:Key="AccentColor">#00E096</Color>
        <Color x:Key="SecondaryTextColor">#A0A0A0</Color>
        
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="White"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource SecondaryTextColor}"/>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- Main Container with Rounded Corners for the Window itself -->
    <Border Background="{StaticResource BgBrush}" CornerRadius="20" BorderThickness="1" BorderBrush="#333">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI Variable Display"/>
                    <TextBlock Text="Overview of your digital habits" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                     <!-- Focus Button (Star Feature) -->
                     <Button x:Name="BtnFocus" 
                             Content="🎯 Focus" 
                             FontSize="12" 
                             Padding="12,6"
                             Background="{StaticResource AccentBrush}"
                             Foreground="Black"
                             FontWeight="Bold"
                             Click="FocusButton_Click"
                             Margin="0,0,15,0"/>
                     <Button Content="✕" FontSize="16" Width="30" Height="30" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. Main Dashboard Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.5*"/> <!-- General Statistics -->
                    <ColumnDefinition Width="4*"/>   <!-- Daily Report -->
                    <ColumnDefinition Width="2.5*"/> <!-- Quick Stats -->
                </Grid.ColumnDefinitions>

                <!-- COL 1: General Statistics -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,20,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="General Statistics" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="(+8% Improve)" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="10,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Content: List + Stacked Bar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/> <!-- List -->
                                <ColumnDefinition Width="1*"/> <!-- Chart -->
                            </Grid.ColumnDefinitions>

                            <!-- App List -->
                            <StackPanel x:Name="AppListPanel" VerticalAlignment="Center"/>

                            <!-- Stacked Bar Visual -->
                            <Border Grid.Column="1" Background="#252525" CornerRadius="15" Margin="10,0,0,0" Padding="5">
                                <Grid x:Name="StackedBarContainer">
                                    <Grid.RowDefinitions>
                                        <!-- Dynamic rows will be added here in code-behind -->
                                    </Grid.RowDefinitions>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- COL 2: Daily Report -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,20,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Header -->
                            <RowDefinition Height="1.2*"/>   <!-- Weekly Chart -->
                            <RowDefinition Height="1*"/>     <!-- Hourly Chart -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Activity Report" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="TxtReportSubtitle" Text="Last 7 Days" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border x:Name="ViewModeBadge" Background="{StaticResource AccentBrush}" CornerRadius="15" HorizontalAlignment="Right" Padding="10,5">
                                <TextBlock Text="Weekly View" FontSize="10" FontWeight="Bold" Foreground="Black"/>
                            </Border>
                        </Grid>

                        <!-- Weekly Chart (always visible) -->
                        <Grid Grid.Row="1" Margin="0,10">
                            <Grid x:Name="WeeklyGraphContainer">
                                <!-- 7 columns for 7 days will be added in code-behind -->
                            </Grid>
                        </Grid>

                        <!-- Hourly Chart (appears when day is clicked) -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid x:Name="HourlyGraphContainer" Visibility="Collapsed">
                                <!-- 24 columns for 24 hours will be added in code-behind -->
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- COL 3: Quick Stats -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Active Time -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                             <TextBlock Text="Total Active Time" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                             <TextBlock x:Name="TxtActiveTime" Text="0h 0m" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                             <ProgressBar Value="75" Height="6" Background="#333" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Margin="0,15,0,0"/> 
                        </StackPanel>
                    </Border>

                    <!-- Uptime -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="System Uptime" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock x:Name="TxtUptime" Text="0h 0m" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
